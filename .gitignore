# --- Node.js / Bot ignores ---
botty-bot/node_modules/
botty-bot/.env

# Temporary audio files generated by the voice pipeline
botty-bot/*.raw
botty-bot/*.wav
botty-bot/*.mp3

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Minecraft Server ignores ---
# Ignore the generated world directory (which can be very large)
Minecraft Server/world/

# Ignore server log files and runtime state
Minecraft Server/logs/
Minecraft Server/.fabric/
Minecraft Server/usercache.json
Minecraft Server/fabricloader.log
Minecraft Server/libraries/
Minecraft Server/versions/
Minecraft Server/server.jar
Minecraft Server/fabric-installer-*.jar


# Ignore server operator/permission and security lists (optional, but recommended for security)
Minecraft Server/ops.json
Minecraft Server/banned-ips.json
Minecraft Server/banned-players.json
Minecraft Server/whitelist.json

# --- OS / IDE ignores ---
.DS_Store
.vscode/
.idea/
